# PyInstaller build artifacts. The built exe is NOT tracked in git (43 MB per
# rebuild bloats the repo) - it ships as an asset on the GitHub Release instead:
#   gh release upload <tag> dist/pc_stats_monitor_v4.exe
build/
dist/
*.spec

# Python cache
__pycache__/
*.pyc

# Local runtime files (config + log live in %APPDATA% for the .exe, but the
# dev script writes them next to this file)
monitor_config.json
monitor*.log
*_backup.json
